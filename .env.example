# ==========================================
# MetaTrader 5 Configuration
# ==========================================
# Path to your MT5 terminal64.exe. If left blank, bot searches common paths automatically.
MT5_PATH=C:\MT5\terminal64.exe

# Optional: Account credentials. If left blank, uses currently logged-in account in MT5.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Timeframe for strategy analysis (M1, M5, M15, M30, H1, H4, D1)
MT5_TIMEFRAME=M5

# Top 5 pairs to trade (comma-separated)
TRADING_PAIRS=EURUSD,GBPUSD,USDJPY,AUDUSD,USDCAD

# ==========================================
# Risk Management & Order Execution
# ==========================================
LOT_SIZE=0.01
MAX_OPEN_POSITIONS=5
MAX_POSITIONS_PER_SYMBOL=1
STOP_LOSS_POINTS=200
TAKE_PROFIT_POINTS=400
DEVIATION_SLIPPAGE=10
MAGIC_NUMBER=778899

# Strategy Parameters (EMA crossover + RSI)
FAST_EMA_PERIOD=9
SLOW_EMA_PERIOD=21
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30

# ==========================================
# MongoDB Configuration
# ==========================================
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=mt5_trading_db

# Loop interval in seconds
LOOP_INTERVAL_SECONDS=5
